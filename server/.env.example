# Server Configuration
PORT=5000
NODE_ENV=development

# Client Origin (for CORS and Socket.IO)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/netflix-ai-watch-spaces

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_super_secret_access_key_replace_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_replace_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Secret
COOKIE_SECRET=your_cookie_signing_secret_here
