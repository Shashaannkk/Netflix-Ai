# Server Configuration
PORT=5000
NODE_ENV=development

# Client Origin (for CORS and Socket.IO)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/netflix-ai-watch-spaces

# JWT Secret (for future auth sessions)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
